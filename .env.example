# ── Zix'Ovibes Frontend Environment Variables ────────────────────────────────
#
# Copy this file to .env and fill in values for local development.
# In production, set these as Netlify environment variables — never commit .env.
#
# Backend API base URL.
# Development: http://localhost:3001
# Production:  your Render backend URL, e.g. https://zixovibes-backend.onrender.com
VITE_API_URL=http://localhost:3001
