# ── Groq AI API Keys ──────────────────────────────────────────────────────────
# At least one key is required. Additional keys provide failover redundancy.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Groq model to use (optional — defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Server ────────────────────────────────────────────────────────────────────
# Port the backend listens on.
# Render automatically sets PORT — do not override it in the Render environment.
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your Netlify URL.
# Example: ALLOWED_ORIGINS=https://zixovibes.netlify.app
# Leave unset for local development (localhost origins are allowed by default).
ALLOWED_ORIGINS=

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Used when deploying without a local service-account JSON file.
# Copy these values from your Firebase service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
